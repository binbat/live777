# Custom cross-rs image for aarch64 builds that must link against
# board-provided shared libraries requiring glibc >= 2.34
# (e.g. librockchip_mpp from a Debian 13 / Ubuntu 24.04 sysroot).
#
# The stock cross image (ghcr.io/cross-rs/aarch64-unknown-linux-gnu:main)
# is Ubuntu 20.04 based (glibc 2.31) and cannot resolve
# pthread_create@GLIBC_2.34 etc. Ubuntu 22.04 ships glibc 2.35.
#
# Build (cross 0.2.5 pins --platform linux/amd64 even on Apple Silicon,
# so the image must be amd64; it runs under Rosetta/QEMU emulation):
#   docker build --platform linux/amd64 \
#     -f docker/Dockerfile.cross-aarch64-u2204 \
#     -t live777-cross-aarch64-u2204:local .
FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        cmake \
        make \
        pkg-config \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CROSS_TOOLCHAIN_PREFIX=aarch64-linux-gnu-
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc-ar \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
