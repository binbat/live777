# Cross-rs image for Rockchip RK3588 (RKMPP) aarch64 builds, published as
# ghcr.io/binbat/crossbuilder-aarch64-rkmpp by the Cross Images workflow.
#
# The sysroot stage builds librockchip_mpp from source (arm64, under QEMU)
# and installs it into /rkmpp-sysroot. The final image is an amd64 Debian 13
# (trixie) container with the aarch64 cross toolchain plus the baked sysroot.
# Debian 13 is required: the stock cross-rs aarch64 image is Ubuntu 20.04
# (glibc 2.31) and cannot link librockchip_mpp.so (needs GLIBC_2.34+).
#
# Local override: set RKMPP_SYSROOT to a sysroot pulled from a device and
# cross mounts it into the container at the same path (see Cross.toml).
#
# MPP source ref: a pinned develop commit, not a release tag — every 1.0.x
# tag on GitHub ships the h265/vp9/av1 decoder dirs without their parser
# sources while the CMakeLists still references them, so the tags do not
# build from a source archive. develop (post decoder refactor) is
# self-consistent again; pin the commit for reproducibility.
ARG MPP_REF=df4864bd1e907cbfd427c397348976c5b2b05ee9

FROM --platform=linux/arm64 debian:trixie-slim AS rkmpp-sysroot
ARG MPP_REF

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential cmake ca-certificates; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /mpp

ADD https://github.com/rockchip-linux/mpp/archive/${MPP_REF}.tar.gz mpp.tar.gz
RUN tar -xf mpp.tar.gz --strip-components 1

RUN cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib/aarch64-linux-gnu \
    && cmake --build build --parallel \
    && DESTDIR=/rkmpp-sysroot cmake --install build

# livehal/build.rs links -lrockchip_mpp from <sysroot>/mpp-lib (a flat dir
# without libc, so the linker never picks up the sysroot's libc); keep a copy
# of the shared-library chain there.
RUN set -eux; \
    mkdir -p /rkmpp-sysroot/mpp-lib; \
    cp -a /rkmpp-sysroot/usr/lib/aarch64-linux-gnu/librockchip_mpp.so* /rkmpp-sysroot/mpp-lib/; \
    test -e /rkmpp-sysroot/mpp-lib/librockchip_mpp.so; \
    test -e /rkmpp-sysroot/usr/include/rockchip/rk_mpi.h

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update; \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        cmake \
        make \
        pkg-config \
        git \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*

ENV CROSS_TOOLCHAIN_PREFIX=aarch64-linux-gnu-
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc-ar \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc

ENV RKMPP_SYSROOT=/opt/rkmpp-sysroot

COPY --from=rkmpp-sysroot /rkmpp-sysroot/ /opt/rkmpp-sysroot/
