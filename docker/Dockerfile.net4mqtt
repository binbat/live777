FROM rust:slim-trixie AS builder

WORKDIR /app

COPY . .

# Stamped into the binaries by libs/version; the build context has no .git.
ARG LIVE777_VERSION

RUN cargo build --bin=net4mqtt --release

FROM debian:trixie-slim

COPY --from=builder /app/target/release/net4mqtt /usr/local/bin/net4mqtt

CMD ["whipinto"]
