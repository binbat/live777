 		offer.sdp = this.onOffer(offer.sdp);
 
+		//Set local description before POST so browser ICE gathering can add
+		//host candidates to the initial offer. Live777's current webrtc-rs
+		//stack accepts late trickle candidates but does not connect when the
+		//initial remote candidate list is empty.
+		await pc.setLocalDescription(offer);
+		await this.waitForIceGatheringComplete(pc);
+		const localDescription = pc.localDescription || offer;
+		const offerSdp = localDescription.sdp;
+		this.iceUsername = offerSdp.match(/a=ice-ufrag:(.*)\r\n/)[1];
+		this.icePassword = offerSdp.match(/a=ice-pwd:(.*)\r\n/)[1];
+		this.candidates = [];
+		this.endOfcandidates = false;
+
 		//Request headers
 		const headers = {
 			"Content-Type": "application/sdp"
@@ -78,7 +114,7 @@ export class WHEPClient extends EventTarget
