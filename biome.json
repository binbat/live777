{
  "$schema": "https://biomejs.dev/schemas/2.3.3/schema.json",
  "files": {
    "includes": [
      "web/player-core/**",
      "!web/player-core/dist",
      "web/player-vue/**",
      "!web/player-vue/dist",
      "web/debugger/**",
      "!web/debugger/dist",
      "libs/playwright-whep/static/**"
    ]
  },
  "formatter": {
    "formatWithErrors": true,
    "useEditorconfig": true
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
